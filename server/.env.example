# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Admin Account ─────────────────────────────────────────────────────────────
# Created automatically on first startup. Use a strong password before deploying.
ADMIN_EMAIL=admin@phishguard.local
ADMIN_PASSWORD=ChangeMe!2026Secure

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DB_NAME=phishguard_pds

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── AI Chat (optional) ────────────────────────────────────────────────────────
# Free key: https://console.groq.com
GROQ_API_KEY=

# ── Threat Intelligence APIs (optional) ──────────────────────────────────────
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# https://console.cloud.google.com → Safe Browsing API
GOOGLE_SAFE_BROWSING_KEY=

# ── Phishing.Database blocklist (enabled by default) ─────────────────────────
# https://github.com/Phishing-Database — feeds from phish.co.za
PHISHING_DB_ENABLED=true
PHISHING_DB_REFRESH_HOURS=12
# PHISHING_DB_DOMAINS_URL=https://phish.co.za/latest/phishing-domains-ACTIVE.txt
# PHISHING_DB_LINKS_URL=https://phish.co.za/latest/phishing-links-ACTIVE.txt

# ── Email Alerts (optional, Gmail example) ───────────────────────────────────
SMTP_FROM=alerts@yourdomain.com
SMTP_ALERT_TO=admin@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
